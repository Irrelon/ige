{
	"compilerOptions": {
		"rootDir": "./src",
		"downlevelIteration": true,
		"baseUrl": ".",
		"target": "es6",
		"lib": [
			"dom",
			"dom.iterable",
			"esnext"
		],
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"strictNullChecks": true,
		"noEmit": false,
		"incremental": true,
		"noErrorTruncation": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"jsxImportSource": "ige-jsx",
		"declaration": false,
		"noImplicitAny": false,
		"composite": false,
		"verbatimModuleSyntax": false,
		"paths": {
			"@/*": [
				"./src/*"
			]
		},
		"types": [
			"@webgpu/types",
			"@types/jest"
		]
	},
	"include": [
		"src/**/*"
	],
	"exclude": [
		"node_modules",
		"react",
		"engine/ui",
		"engine/components/editor",
		"engine/components/physics/cannon",
		"engine/components/three",
		"*.old*",
		"other",
		"dist"
	]
}
